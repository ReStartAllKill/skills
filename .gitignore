.DS_Store
__pycache__/
*.pyc

# Track shared SDLC configuration; ignore personal settings and runtime state.
.claude/settings.local.json
.claude/worktrees/
.claude/autonomy-runs.jsonl

# Ignore local artifacts but retain spec_dir so checks work in fresh clones.
.sdlc/*
!.sdlc/specs/
.sdlc/specs/*
!.sdlc/specs/.gitkeep
# Anchored: an unanchored `docs/` also swallowed every eval case's docs/ fixture, and the
# case then passed on the machine that wrote it while failing on a fresh clone.
/docs/

# Local agent guidance; README.md is the tracked entry point.
CLAUDE.md
